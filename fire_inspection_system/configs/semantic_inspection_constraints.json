{
  "version": 1,
  "description": "同楼层语义巡检硬约束。候选匹配按规范类别、按楼层执行：CAD 原始对象名优先；该类别在本层没有原始名候选时才回退 standard_class_name。",
  "scope": "per_floor",
  "matching_policy": {
    "original_name_first": true,
    "classification_fallback_only_when_no_original_candidate": true,
    "deduplicate_by": [
      "floor_id",
      "object_id"
    ]
  },
  "route_policy": {
    "path_type": "open",
    "free_start": true,
    "free_end": true,
    "distance_source": "euclidean_target_distance_approximation",
    "euclidean_fallback": false,
    "distance_tolerance_experiments": [
      0.0,
      0.05,
      0.1
    ],
    "soft_empty_gap_floor_scale_ratio": 0.2,
    "hard_max_gap_floor_scale_ratio": 0.8,
    "nearby_high_risk_floor_scale_ratio": 0.05,
    "virtual_access_max_floor_scale_ratio": 0.01,
    "virtual_access_min_grid_pixels": 3,
    "physical_path_claim": false
  },
  "rules": [
    {
      "id": "mandatory_all",
      "name": "强制目标全部巡检",
      "type": "mandatory_all",
      "classes": [
        "安全出口",
        "消防水泵房/消防泵房",
        "开闭所",
        "用户变",
        "消防控制室/消控室",
        "供水装置",
        "消防水箱",
        "消防联动控制器及消防控制室图形显示装置",
        "消防水泵",
        "供水水源/消防水池",
        "备用发电机/柴油发电机房"
      ]
    },
    {
      "id": "ordinary_quota",
      "name": "普通配额目标每类两处",
      "type": "quota_per_class",
      "quota": 2,
      "classes": [
        "避难间",
        "配电房",
        "消防电梯",
        "防火卷帘",
        "灭火器",
        "储存装置间/灭火剂储存装置/驱动装置",
        "报警阀组",
        "喷头",
        "灭火装置",
        "管网与喷头",
        "变配电房",
        "消防应急照明和疏散指示标志",
        "火灾探测器",
        "消防通讯",
        "布线",
        "应急广播及警报装置",
        "区域显示器",
        "手动报警按钮",
        "火灾报警控制器",
        "机械防烟/机械加压送风",
        "自然通风/自然防烟",
        "加压风机（管道）/排烟风机（管道）/补风机（管道）",
        "机械排烟",
        "自然排烟",
        "防火阀/排烟防火阀"
      ]
    },
    {
      "id": "hydrants",
      "name": "室内外消火栓每层四处",
      "type": "quota_per_class",
      "quota": 4,
      "classes": [
        "室外（内）消火栓"
      ]
    },
    {
      "id": "fan_room_group",
      "name": "风机房组选择两个不同类别且每类一个实例",
      "type": "distinct_category_group",
      "required_distinct_categories": 2,
      "instances_per_category": 1,
      "classes": [
        "风机房",
        "进风机房",
        "补风机房",
        "排烟机",
        "排烟机房"
      ]
    },
    {
      "id": "electrical_room_group",
      "name": "强弱电间组选择两个不同类别且每类一个实例",
      "type": "distinct_category_group",
      "required_distinct_categories": 2,
      "instances_per_category": 1,
      "classes": [
        "强电间",
        "弱电间",
        "强弱电间",
        "电井"
      ]
    }
  ]
}
