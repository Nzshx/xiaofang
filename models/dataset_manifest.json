  "feature_policy_v1": {
    "standard_portal_relation": {
      "continuous_features": [
        "width / floor_scale",
        "clearance / floor_scale",
        "bottleneck_score",
        "confidence"
      ],
      "gate": "sigmoid(MLP(edge_features_and_missing_mask))"
    },
    "connector_portal_relation": {
      "continuous_features": [
        "gap_distance / floor_scale",
        "evidence_distance / floor_scale when available",
        "confidence"
      ],
      "categorical_features": ["evidence_source"],
      "width_and_clearance_policy": "missing_with_explicit_mask; gap_distance is not clearance",
      "gate": "separate connector-portal MLP"
    },
    "physical_navigation_edge": {
      "continuous_features": ["length / floor_scale"],
      "clearance_used": false,
      "gate": "length-only in v1"
    },
    "near_target_relation": {
      "continuous_features": [
        "distance_euclidean / floor_scale",
        "decay",
        "normalized_weight",
        "first_order_contribution"
      ],
      "semantic_graph_policy": "regenerate with current 15-percent neighborhood code"
    },
    "missing_value_policy": "Never encode a missing physical quantity as zero; add a binary availability mask."
  },
  "supervision_policy": {
    "human_route_labels_available": false,
    "human_selection_labels_available": false,
    "phase_1_self_supervised_tasks": [
      "masked node-type and target-category reconstruction",
      "LOCATED_IN_AREA and ACCESSIBLE_FROM link prediction",
      "Area-Portal-Area relation reconstruction",
      "continuous edge-attribute reconstruction",
      "same-floor versus illegal cross-floor edge discrimination",
      "floor-graph contrastive consistency"
    ],
    "phase_2_pseudo_label_teacher": "component-constrained open selective TSP",
    "pseudo_label_requirements": [
      "apply mandatory, quota, and distinct-category hard constraints",
      "generate top-K solutions for delta 0, 0.05, and 0.10 with multiple seeds",
      "physically validate selected consecutive legs on the refined navigation graph",
      "reject or repair cross-component and unavailable transitions",
      "use top-K selection frequency as soft node labels",
      "use top-K consecutive-edge frequency as soft transition labels"
    ],
    "phase_3_human_review": "small pairwise route-preference audit; full hand-drawn routes are not required"
  },
